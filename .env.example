# Copy this file to .env and fill in real values before running.
# Never commit the real .env file.

DEBUG=True
SECRET_KEY=change-me-to-a-random-value

# Base domain used for tenant subdomains in local development.
# A signed-up client "westernprovince" becomes westernprovince.mms.local
BASE_DOMAIN=mms.local

POSTGRES_DB=mms
POSTGRES_USER=mms
POSTGRES_PASSWORD=mms
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Email notifications. Defaults to printing emails to the web container's
# logs instead of actually sending anything -- safe for local dev, no
# credentials needed. Swap EMAIL_BACKEND to
# django.core.mail.backends.smtp.EmailBackend and set the EMAIL_HOST_*
# values below to send real email.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=mms@example.org
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
